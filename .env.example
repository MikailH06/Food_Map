# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values you need.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit it — SUPABASE_SERVICE_ROLE_KEY grants full,
# unrestricted access to your database.
#
# EVERYTHING HERE IS OPTIONAL FOR LOCAL DEVELOPMENT. With no .env at all the
# app runs against PGlite (an in-process Postgres) with auth disabled, so you
# can build and test the entire backend before creating any cloud account.
# ---------------------------------------------------------------------------

# --- Server ---------------------------------------------------------------
PORT=3000
# Comma-separated list of browser origins allowed to call this API.
# Add your Render URL here when you deploy.
CORS_ORIGINS=http://localhost:3000


# --- Database -------------------------------------------------------------
# Leave DATABASE_URL blank to use PGlite locally (no install required).
#
# For Supabase: Dashboard -> Project Settings -> Database -> Connection string
# -> "Transaction pooler". Use the pooler (port 6543), not a direct connection.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Where PGlite keeps its files. 'memory://' gives a throwaway database.
PGLITE_DIR=./.data/pglite


# --- Supabase (auth + photo storage) --------------------------------------
# Dashboard -> Project Settings -> API
# SUPABASE_URL=https://<your-project-ref>.supabase.co

# Safe to send to the browser: it can only do what row-level security permits.
# SUPABASE_ANON_KEY=

# SECRET. Bypasses row-level security entirely. Server-side only, never commit.
# SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=restaurant-photos


# --- Google (optional, costs money) ---------------------------------------
# Setting this key is the ONLY step needed to switch the app over to Google.
# The Google map and Places providers are fully implemented; they are simply
# unreachable while this is empty. Leave it blank to stay entirely free.
# GOOGLE_MAPS_API_KEY=

# Override the automatic choice if you want Google Places data but Leaflet maps.
# MAP_PROVIDER=leaflet
# GEOCODING_PROVIDER=auto


# --- Enrichment crawler ---------------------------------------------------
# Reads the structured data (schema.org JSON-LD, Open Graph) that restaurants
# publish on their own websites for search engines.
ENRICHMENT_ENABLED=true
ENRICH_CONCURRENCY=3
ENRICH_REFRESH_DAYS=30

# Download discovered images into Supabase Storage instead of hotlinking them.
# Off by default — the free storage tier is 1GB.
REHOST_PHOTOS=false


# --- Seeding --------------------------------------------------------------
# OVERPASS_URL=https://overpass-api.de/api/interpreter
